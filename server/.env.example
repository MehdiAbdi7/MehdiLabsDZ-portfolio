# Chaîne de connexion MongoDB Atlas (ne jamais committer le vrai fichier .env).
MONGO_URI=mongodb+srv://<utilisateur>:<motdepasse>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Port d'écoute local. Render fournit sa propre valeur automatiquement.
PORT=5000

# Origines autorisées par CORS, séparées par des virgules.
CORS_ORIGINS=http://localhost:3000,https://mehdilabsdz.netlify.app
